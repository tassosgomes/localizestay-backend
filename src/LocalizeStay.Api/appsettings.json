{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "LocalizeStay": "Host=localhost;Port=5432;Database=localizestay;Username=localizestay;Password=localizestay"
  },
  "OpenTelemetry": {
    "ServiceName": "localizestay-api",
    "OtlpEndpoint": ""
  },
  "LogTo": {
    "Issuer": "https://lstay-auth.tasso.dev.br/oidc",
    "Audience": "https://api.localizestay.com",
    "ScopeClaimType": "scope",
    "PermissionClaimType": "permission"
  },
  "Inventory": {
    "UpstreamEligibility": {
      "Mode": "Pilot",
      "EligiblePreselectionIds": [ "pilot-preselection-001" ],
      "ApprovedDestinationIds": [ "recife-pe" ]
    },
    "BusinessCalendar": {
      "Version": "pilot-2026-07-19",
      "TimeZone": "America/Fortaleza",
      "WorkingDays": [ "Monday", "Tuesday", "Wednesday", "Thursday", "Friday" ],
      "StartTime": "08:00",
      "EndTime": "18:00",
      "Holidays": [],
      "CommunicationSlaBusinessHours": 4
    },
    "LegalPolicies": {
      "RuleSets": [
        {
          "Type": "flexible",
          "Title": "Flexivel",
          "RulesSummary": "Cancelamento gratuito ate sete dias antes do check-in. Apos esse prazo, sera cobrada uma diaria. Nao comparecimento sem aviso previo implica cobranca integral da reserva.",
          "RuleSetVersion": "BR-2026-01"
        },
        {
          "Type": "nonRefundable",
          "Title": "Nao-Reembolsavel",
          "RulesSummary": "O valor total da reserva e cobrado no momento da confirmacao. Cancelamentos voluntarios, nao comparecimento ou saida antecipada nao geram reembolso, ressalvadas hipoteses previstas no Codigo de Defesa do Consumidor.",
          "RuleSetVersion": "BR-2026-01"
        }
      ]
    }
  },
  "RateLimit": {
    "ConcurrencyLimit": 50,
    "PermitLimit": 100,
    "TokensPerSecond": 20,
    "QueueLimit": 10
  }
}
